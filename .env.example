# Copy this file to .env and fill it in. Never commit .env.

# --- Site (optional here) -----------------------------------------------------------------------
# The production build reads the store domain and public token from .env.production, which is in
# the repo. Set them here only to use the real store with `npm run dev`; without them, dev uses
# the demo catalog and demo checkout.
# VITE_SHOPIFY_DOMAIN=tfxq1v-jc.myshopify.com
# VITE_SHOPIFY_STOREFRONT_TOKEN=

# --- Product upload (npm run shopify:push), only needed on your computer --------------------------
# From your app in the Shopify Dev Dashboard (scopes: write_products, write_inventory,
# read_locations, write_publications), installed on your store
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Where product images are downloaded from. The site must be live here when you run the upload.
SITE_URL=https://gempacktcg.com

# Optional
# SHOPIFY_STORE_DOMAIN=tfxq1v-jc.myshopify.com    # defaults to VITE_SHOPIFY_DOMAIN in .env.production
# SHOPIFY_API_VERSION=2026-07
# SHOPIFY_PUBLICATIONS=headless|online store      # which sales channels to publish products to
