# Copy this file to .env and fill it in. Never commit .env.

# --- Site checkout (also add these two as Cloudflare build variables) ----------------------------
# Your store's myshopify.com address
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Public access token from Shopify admin > Sales channels > Headless > your storefront
VITE_SHOPIFY_STOREFRONT_TOKEN=

# --- Product upload (npm run shopify:push), only needed on your computer --------------------------
# From your app in the Shopify Dev Dashboard (scopes: write_products, write_inventory,
# read_locations, write_publications), installed on the store above
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Where product images are downloaded from. The site must be live here when you run the upload.
SITE_URL=https://gempacktcg.com

# Optional
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com   # defaults to VITE_SHOPIFY_STORE_DOMAIN
# SHOPIFY_API_VERSION=2026-07
# SHOPIFY_PUBLICATIONS=headless|online store      # which sales channels to publish products to
