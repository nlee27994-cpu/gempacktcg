# Public Shopify settings, built into the site by `npm run build` (Cloudflare uses this too).
# The Storefront token is the PUBLIC one from Shopify admin > Sales channels > Headless, which is
# safe to ship in a static site. Never put the Admin API token or app client secret here.
VITE_SHOPIFY_DOMAIN=tfxq1v-jc.myshopify.com
# VITE_SHOPIFY_STOREFRONT_TOKEN=paste-the-public-storefront-token-here
