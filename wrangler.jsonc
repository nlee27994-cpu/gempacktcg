{
  // Cloudflare Workers deploy settings (used by `npx wrangler deploy`).
  // The site is fully static: Cloudflare serves the Vite build in ./dist, and any
  // address that isn't a file (/auctions, /admin, /product/...) gets index.html so the
  // React router can handle it.
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gempacktcg",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
